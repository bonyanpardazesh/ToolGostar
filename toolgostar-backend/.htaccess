# ============================================================================
# ToolGostar Backend .htaccess Configuration
# For cPanel Node.js Application (Passenger-managed, no mod_proxy)
# ============================================================================

RewriteEngine On
RewriteBase /

# ============================================================================
# FORCE HTTPS (Optional - uncomment in production)
# ============================================================================
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ============================================================================
# DO NOT USE MANUAL PROXY RULES HERE
# cPanel routes /api/* to Node.js via Application URL.
# If you need /uploads from Node, rewrite in ROOT .htaccess to /api/uploads/*
# ============================================================================

# ============================================================================
# SECURITY HEADERS
# ============================================================================
<IfModule mod_headers.c>
    # CORS (public API responses can be cached by browsers/CDNs)
    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, PATCH, OPTIONS"
    Header always set Access-Control-Allow-Headers "Origin, X-Requested-With, Content-Type, Accept, Authorization, X-API-Key, X-Session-ID"
    Header always set Access-Control-Allow-Credentials "true"

    # Security
    Header always set X-Frame-Options "DENY"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set X-Content-Type-Options "nosniff"
</IfModule>

# ============================================================================
# PROTECT SENSITIVE FILES
# ============================================================================
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

<FilesMatch "\.env">
    Order allow,deny
    Deny from all
</FilesMatch>

<FilesMatch "(package\.json|package-lock\.json|\.gitignore|\.git)">
    Order allow,deny
    Deny from all
</FilesMatch>

<FilesMatch "\.sqlite$">
    Order allow,deny
    Deny from all
</FilesMatch>

<FilesMatch "\.(bak|backup|old|orig|save|swp)$">
    Order allow,deny
    Deny from all
</FilesMatch>

<FilesMatch "\.log$">
    Order allow,deny
    Deny from all
</FilesMatch>

# ============================================================================
# COMPRESSION (Gzip)
# ============================================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE text/plain
</IfModule>